# Client-side environment for the Supabase Realtime relay.
# Copy to `.env.local` (gitignored) and fill in real values.
# These values are safe to expose in the browser bundle.

# Supabase project URL (from Project Settings -> API -> "Project URL")
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Supabase anon public key (from Project Settings -> API -> "anon public")
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Deployed Edge Function endpoint. After `npx supabase functions deploy authorize-activity`,
# copy the URL from the Functions dashboard. It looks like:
VITE_RELAY_FUNCTION_URL=https://<PROJECT_REF>.supabase.co/functions/v1/authorize-activity

# Discord application client id (used to render the Discord auth flow / banner).
VITE_DISCORD_CLIENT_ID=<discord-application-client-id>

# --- Server-side secrets (set in the Supabase dashboard, NOT in this file) ---
# Project Settings -> Functions -> authorize-activity -> Secrets -> Add new
#   SERVICE_ROLE_KEY      = your project's service_role key (Project Settings -> API)
#   DISCORD_CLIENT_ID     = your Discord application client id
#   DISCORD_CLIENT_SECRET = your Discord application client secret
